*** WL/M: a Wolfram-Language core on Maude. Phases 0-1.
***
*** Expressions are terms of sort Expr; the global rulebase and attribute
*** table are ordinary data threaded through the evaluator; pattern
*** matching runs on Maude's engine via metaMatch against WL-SYNTAX, with
*** WL blanks translated to meta-variables (sequence blanks become
*** ArgList variables, so associative matching provides sequence
*** semantics).
***
*** Deliberate divergences from WL (see docs/wolfram-on-maude.md):
*** - `?? q` has BlankNullSequence (0+) semantics; BlankSequence (1+) and
***   head-typed blanks arrive in Phase 2.
*** - Set/SetDelayed hold their entire lhs (WL evaluates lhs arguments).
*** - Orderless canonical order is ours (rank, then structural), not WL's.
*** - Flat/Orderless affect evaluation-time normalization; matching
***   modulo Flat/Orderless axioms is still pending (1.2b).
*** - Definition order: specificity = non-variable node count of the
***   compiled pattern, descending; ties keep definition order.

fmod WL-SYNTAX is
  protecting INT .
  protecting STRING .
  protecting QID .
  sorts Expr ArgList .
  subsort Expr < ArgList .
  subsort Int < Expr .
  op s : Qid -> Expr [ctor] .              *** symbol
  op str : String -> Expr [ctor] .         *** string atom
  op ap : Expr ArgList -> Expr [ctor] .    *** application h[args]
  op nilA : -> ArgList [ctor] .
  op _::_ : ArgList ArgList -> ArgList [ctor assoc id: nilA prec 60] .
  op ?_ : Qid -> Expr [ctor prec 5] .      *** Blank[q]  (q_)
  op ??_ : Qid -> Expr [ctor prec 5] .     *** BlankNullSequence[q]  (q___)
endfm

fmod WL-BINDINGS is
  protecting WL-SYNTAX .
  sorts Bnd Bnds .
  subsort Bnd < Bnds .
  op bnd : Qid ArgList -> Bnd [ctor] .
  op noBnds : -> Bnds [ctor] .
  op _&_ : Bnds Bnds -> Bnds [ctor assoc comm id: noBnds] .

  var Q : Qid . var A : ArgList . var B : Bnds .
  var E H E2 : Expr .

  *** partial lookup: unreduced (kind) when unbound - callers sort-test
  op lookupB : Bnds Qid ~> ArgList .
  eq lookupB(bnd(Q, A) & B, Q) = A .

  *** substitute bound symbols in a rule rhs; sequence bindings splice
  *** into argument lists via the associative _::_
  op sbA : ArgList Bnds -> ArgList .
  op sbA1 : Expr Bnds -> ArgList .
  op sbE : Expr Bnds -> Expr .
  eq sbA(nilA, B) = nilA .
  eq sbA(E :: A, B) = sbA1(E, B) :: sbA(A, B) .
  eq sbA1(s(Q), B) = if lookupB(B, Q) :: ArgList then lookupB(B, Q) else s(Q) fi .
  eq sbA1(ap(H, A), B) = ap(sbE(H, B), sbA(A, B)) .
  eq sbA1(E, B) = E [owise] .
  ceq sbE(E, B) = E2 if E2 := sbA1(E, B) .
  eq sbE(E, B) = ap(s('Sequence), sbA1(E, B)) [owise] .
endfm

*** total order on expressions for Orderless canonicalization
fmod WL-ORDER is
  protecting WL-BINDINGS .
  var I J : Int . var Q Q2 : Qid . var Str Str2 : String .
  var E E2 H H2 : Expr . var A A2 : ArgList .

  op rank : Expr -> Nat .
  eq rank(I) = 0 .
  eq rank(str(Str)) = 1 .
  eq rank(s(Q)) = 2 .
  eq rank(? Q) = 3 .
  eq rank(?? Q) = 4 .
  eq rank(ap(H, A)) = 5 .

  op ltE : Expr Expr -> Bool .
  op ltA : ArgList ArgList -> Bool .
  ceq ltE(E, E2) = rank(E) < rank(E2) if rank(E) =/= rank(E2) .
  eq ltE(I, J) = I < J .
  eq ltE(str(Str), str(Str2)) = Str < Str2 .
  eq ltE(s(Q), s(Q2)) = string(Q) < string(Q2) .
  eq ltE(? Q, ? Q2) = string(Q) < string(Q2) .
  eq ltE(?? Q, ?? Q2) = string(Q) < string(Q2) .
  ceq ltE(ap(H, A), ap(H2, A2)) = ltE(H, H2) if H =/= H2 .
  eq ltE(ap(H, A), ap(H, A2)) = ltA(A, A2) .
  eq ltE(E, E2) = false [owise] .
  eq ltA(nilA, nilA) = false .
  eq ltA(nilA, E :: A) = true .
  eq ltA(E :: A, nilA) = false .
  ceq ltA(E :: A, E2 :: A2) = ltE(E, E2) if E =/= E2 .
  eq ltA(E :: A, E :: A2) = ltA(A, A2) .

  *** insertion sort
  op sortA : ArgList -> ArgList .
  op insA : Expr ArgList -> ArgList .
  eq sortA(nilA) = nilA .
  eq sortA(E :: A) = insA(E, sortA(A)) .
  eq insA(E, nilA) = E .
  eq insA(E, E2 :: A) = if ltE(E2, E) then E2 :: insA(E, A) else E :: E2 :: A fi .
endfm

fmod WL-META is
  protecting WL-ORDER .
  protecting META-LEVEL .

  op MOD : -> Module [memo] .
  eq MOD = upModule('WL-SYNTAX, true) .

  var C : Constant . var V : Variable . var F : Qid . var T T2 : Term .
  var TL : TermList . var NeTL : NeTermList .
  var Sb : Substitution . var A : ArgList . var S : String .

  *** upTerm here types qid atoms as ''q.Sort (Sort < Qid in the
  *** metalevel); retype them to ''q.Qid, which is what MOD expects.
  op reQ : Constant -> Constant .
  eq reQ(C) = qid(string(getName(C)) + ".Qid") .

  *** meta variable for a blank: 'q -> q:Expr / q:ArgList
  op blankVar : Constant String -> Qid .
  eq blankVar(C, S)
    = qid(substr(string(getName(C)), 1, length(string(getName(C)))) + S) .

  *** normalize a subject's metarepresentation for MOD (retyping only)
  op nm : Term -> Term .
  op nmL : TermList -> TermList .
  eq nm('s[C]) = 's[reQ(C)] .
  eq nm('?_[C]) = '?_[reQ(C)] .
  eq nm('??_[C]) = '??_[reQ(C)] .
  eq nm(F[NeTL]) = F[nmL(NeTL)] [owise] .
  eq nm(T) = T [owise] .
  eq nmL((T, TL)) = nm(T), nmL(TL) .
  eq nmL(empty) = empty .

  *** compile a pattern: blanks become meta variables
  op p2m : Term -> Term .
  op p2mL : TermList -> TermList .
  eq p2m('?_[C]) = blankVar(C, ":Expr") .
  eq p2m('??_[C]) = blankVar(C, ":ArgList") .
  eq p2m('s[C]) = 's[reQ(C)] .
  eq p2m(F[NeTL]) = F[p2mL(NeTL)] [owise] .
  eq p2m(T) = T [owise] .
  eq p2mL((T, TL)) = p2m(T), p2mL(TL) .
  eq p2mL(empty) = empty .

  op subj : ArgList -> Term .
  eq subj(A) = nm(upTerm(A)) .
  op compileP : ArgList -> Term .
  eq compileP(A) = p2m(upTerm(A)) .

  *** specificity: count of non-variable nodes in a compiled pattern
  op spec : Term -> Nat .
  op specL : TermList -> Nat .
  eq spec(V) = 0 .
  eq spec(F[NeTL]) = 1 + specL(NeTL) [owise] .
  eq spec(T) = 1 [owise] .
  eq specL((T, TL)) = spec(T) + specL(TL) .
  eq specL(empty) = 0 .

  *** metalevel substitution -> bindings
  op dn : Term ~> ArgList .
  eq dn(T) = downTerm(T, s('$downTermError)) .
  op s2b : Substitution -> Bnds .
  ceq s2b((V <- T) ; Sb) = bnd(getName(V), A) & s2b(Sb) if A := dn(T) .
  eq s2b(none) = noBnds .
endfm

fmod WL-EVAL is
  protecting WL-META .

  *** attribute table: a set of (symbol, attribute) pairs
  sorts SymAttr Attrs .
  subsort SymAttr < Attrs .
  op at : Qid Qid -> SymAttr [ctor] .
  op noAt : -> Attrs [ctor] .
  op _&&_ : Attrs Attrs -> Attrs [ctor assoc comm id: noAt] .

  *** rulebase: compiled lhs pattern (meta term) + rhs, ordered by
  *** specificity (descending), ties in definition order
  sorts Def Defs St R .
  op d : Term Expr -> Def [ctor] .
  op noD : -> Defs [ctor] .
  op _|_ : Def Defs -> Defs [ctor prec 70 gather (e E)] .
  op st : Defs Attrs Nat -> St [ctor] .     *** defs, attributes, fuel
  op r : St ArgList -> R [ctor] .

  var S S0 S1 S2 : St . var Ds Ds0 : Defs . var Dd : Def .
  var N : Nat . var I J : Int .
  var E E1 H L Rh Cnd V HV Last : Expr .
  var A A1 AV Rest : ArgList .
  var Q F AT : Qid . var B : Bnds . var Sb : Substitution .
  var P UM T : Term . var Str : String . var At : Attrs .

  *** ---------------------------------------------------- attributes
  op hasAttr : Attrs Qid Qid -> Bool .
  eq hasAttr(at(F, AT) && At, F, AT) = true .
  eq hasAttr(At, F, AT) = false [owise] .
  op hasAttrE : Attrs Expr Qid -> Bool .
  eq hasAttrE(At, s(F), AT) = hasAttr(At, F, AT) .
  eq hasAttrE(At, E, AT) = false [owise] .
  op delAt : Attrs Qid Qid -> Attrs .
  eq delAt(at(F, AT) && At, F, AT) = delAt(At, F, AT) .
  eq delAt(At, F, AT) = At [owise] .
  op attrsOf : Attrs Qid -> ArgList .
  eq attrsOf(at(F, AT) && At, F) = insA(s(AT), attrsOf(At, F)) .
  eq attrsOf(At, F) = nilA [owise] .

  *** WL builtins ship with attributes
  op defaultAttrs : -> Attrs .
  eq defaultAttrs
    = at('Plus, 'Flat) && at('Plus, 'Orderless) && at('Plus, 'OneIdentity)
   && at('Times, 'Flat) && at('Times, 'Orderless) && at('Times, 'OneIdentity)
   && at('Hold, 'HoldAll) && at('HoldForm, 'HoldAll)
   && at('If, 'HoldRest) && at('Set, 'HoldFirst)
   && at('SetDelayed, 'HoldAll) && at('CompoundExpression, 'HoldAll)
   && at('SetAttributes, 'HoldFirst) && at('ClearAttributes, 'HoldFirst)
   && at('Attributes, 'HoldAll) && at('Sequence, 'SequenceHold) .

  *** ---------------------------------------------------- definitions
  op delDef : Defs Term -> Defs .
  eq delDef(noD, P) = noD .
  eq delDef(d(P, Rh) | Ds, P) = delDef(Ds, P) .
  eq delDef(Dd | Ds, P) = Dd | delDef(Ds, P) [owise] .

  *** insert keeping specificity descending; equal scores go after
  *** existing entries (definition order)
  op insDef : Defs Def -> Defs .
  eq insDef(noD, Dd) = Dd | noD .
  eq insDef(d(P, Rh) | Ds, d(T, E))
    = if spec(T) > spec(P)
      then d(T, E) | d(P, Rh) | Ds
      else d(P, Rh) | insDef(Ds, d(T, E)) fi .

  op addDef : St Expr Expr -> St .
  ceq addDef(st(Ds, At, N), L, Rh) = st(insDef(delDef(Ds, P), d(P, Rh)), At, N)
    if P := compileP(L) .

  *** ---------------------------------------------------- evaluator
  op ev : St Expr -> R .
  op evSeq : St ArgList Expr -> R .
  op evArgs : St Expr ArgList -> R .
  op evAll : St ArgList -> R .
  op evHeld : St ArgList -> R .
  op apply : St Expr -> R .
  op tryDefs : St Term Defs Expr -> R .
  op builtin : St Expr -> R .
  op ifBr : St Expr ArgList -> R .

  *** heads with hard-wired evaluation, handled before arg evaluation
  op isSpecial : Expr -> Bool .
  eq isSpecial(s('If)) = true .
  eq isSpecial(s('Set)) = true .
  eq isSpecial(s('SetDelayed)) = true .
  eq isSpecial(s('Hold)) = true .
  eq isSpecial(s('HoldForm)) = true .
  eq isSpecial(s('CompoundExpression)) = true .
  eq isSpecial(E) = false [owise] .

  *** atoms and inert forms
  eq ev(S, I) = r(S, I) .
  eq ev(S, str(Str)) = r(S, str(Str)) .
  eq ev(S, s(Q)) = r(S, s(Q)) .
  eq ev(S, ? Q) = r(S, ? Q) .
  eq ev(S, ?? Q) = r(S, ?? Q) .

  *** special heads
  ceq ev(S0, ap(s('If), Cnd :: Rest)) = ifBr(S1, V, Rest)
    if r(S1, V) := ev(S0, Cnd) .
  eq ifBr(S, s('True), E :: Rest) = ev(S, E) .
  eq ifBr(S, s('False), E :: E1 :: Rest) = ev(S, E1) .
  eq ifBr(S, s('False), E) = r(S, s('Null)) .
  eq ifBr(S, V, Rest) = r(S, ap(s('If), V :: Rest)) [owise] .

  eq ev(S, ap(s('SetDelayed), L :: Rh)) = r(addDef(S, L, Rh), s('Null)) .
  ceq ev(S0, ap(s('Set), L :: Rh)) = r(addDef(S1, L, V), V)
    if r(S1, V) := ev(S0, Rh) .

  eq ev(S, ap(s('Hold), A)) = r(S, ap(s('Hold), A)) .
  eq ev(S, ap(s('HoldForm), A)) = r(S, ap(s('HoldForm), A)) .

  eq ev(S, ap(s('CompoundExpression), A)) = evSeq(S, A, s('Null)) .
  eq evSeq(S, nilA, Last) = r(S, Last) .
  ceq evSeq(S0, E :: A, Last) = evSeq(S1, A, V)
    if r(S1, V) := ev(S0, E) .

  *** generic application: evaluate head, args per Hold*, splice
  *** Sequence, flatten (Flat), canonically order (Orderless), apply
  ceq ev(S0, ap(H, A)) = apply(S2, norm(S2, ap(HV, AV)))
    if not isSpecial(H) /\
       r(S1, HV) := ev(S0, H) /\
       r(S2, AV) := evArgs(S1, HV, A) .

  eq evArgs(S, HV, nilA) = r(S, nilA) .
  ceq evArgs(S, HV, A) = evHeld(S, A)
    if hasAttrE(third(S), HV, 'HoldAll) .
  ceq evArgs(S0, HV, E :: A) = r(S1, E :: AV)
    if hasAttrE(third(S0), HV, 'HoldRest) /\ r(S1, AV) := evHeldTail(S0, E, A) .
  ceq evArgs(S0, HV, E :: A) = r(S2, V :: AV)
    if hasAttrE(third(S0), HV, 'HoldFirst) /\
       r(S1, V) := evHeld1(S0, E) /\ r(S2, AV) := evAll(S1, A) .
  eq evArgs(S, HV, A) = evAll(S, A) [owise] .

  op third : St -> Attrs .
  eq third(st(Ds, At, N)) = At .

  *** held tail helper: first arg evaluated, rest held
  op evHeldTail : St Expr ArgList -> R .
  ceq evHeldTail(S0, E, A) = r(S2, V :: AV)
    if r(S1, V) := ev(S0, E) /\ r(S2, AV) := evHeld(S1, A) .

  eq evAll(S, nilA) = r(S, nilA) .
  ceq evAll(S0, E :: A) = r(S2, V :: AV)
    if r(S1, V) := ev(S0, E) /\ r(S2, AV) := evAll(S1, A) .

  *** held args still honor Evaluate[...]
  op evHeld1 : St Expr -> R .
  eq evHeld1(S, ap(s('Evaluate), E)) = ev(S, E) .
  eq evHeld1(S, E) = r(S, E) [owise] .
  eq evHeld(S, nilA) = r(S, nilA) .
  ceq evHeld(S0, E :: A) = r(S2, V :: AV)
    if r(S1, V) := evHeld1(S0, E) /\ r(S2, AV) := evHeld(S1, A) .

  *** normalization pipeline
  op norm : St Expr -> Expr .
  ceq norm(st(Ds, At, N), ap(s(F), A))
    = ap(s(F), sortIf(At, F, flatIf(At, F, spliceIf(At, F, A))))
    if true .
  eq norm(S, E) = E [owise] .

  op spliceIf : Attrs Qid ArgList -> ArgList .
  eq spliceIf(At, F, A)
    = if hasAttr(At, F, 'SequenceHold) then A else spliceA(A) fi .
  op spliceA : ArgList -> ArgList .
  eq spliceA(nilA) = nilA .
  eq spliceA(ap(s('Sequence), A1) :: A) = A1 :: spliceA(A) .
  eq spliceA(E :: A) = E :: spliceA(A) [owise] .

  op flatIf : Attrs Qid ArgList -> ArgList .
  eq flatIf(At, F, A) = if hasAttr(At, F, 'Flat) then flatA(F, A) else A fi .
  op flatA : Qid ArgList -> ArgList .
  eq flatA(F, nilA) = nilA .
  eq flatA(F, ap(s(F), A1) :: A) = flatA(F, A1) :: flatA(F, A) .
  eq flatA(F, E :: A) = E :: flatA(F, A) [owise] .

  op sortIf : Attrs Qid ArgList -> ArgList .
  eq sortIf(At, F, A) = if hasAttr(At, F, 'Orderless) then sortA(A) else A fi .

  eq apply(st(Ds, At, 0), E) = r(st(Ds, At, 0), s('$Aborted)) .
  ceq apply(st(Ds, At, N), E) = tryDefs(st(Ds, At, N), subj(E), Ds, E) if N > 0 .

  *** first (most specific) definition whose pattern matches wins; a
  *** successful application consumes fuel and re-evaluates
  ceq tryDefs(st(Ds0, At, s N), UM, d(P, Rh) | Ds, E)
    = ev(st(Ds0, At, N), sbE(Rh, s2b(Sb)))
    if Sb := metaMatch(MOD, P, UM, nil, 0) .
  eq tryDefs(S, UM, Dd | Ds, E) = tryDefs(S, UM, Ds, E) [owise] .
  eq tryDefs(S, UM, noD, E) = builtin(S, E) .

  *** ---------------------------------------------------- builtins
  op lenA : ArgList -> Nat .
  eq lenA(nilA) = 0 .
  eq lenA(E :: A) = 1 + lenA(A) .

  op bool2wl : Bool -> Expr .
  eq bool2wl(true) = s('True) .
  eq bool2wl(false) = s('False) .

  *** Plus/Times: args arrive canonically ordered (ints first); fold the
  *** numeric prefix, keep the symbolic tail
  eq builtin(S, ap(s('Plus), nilA)) = r(S, 0) .
  eq builtin(S, ap(s('Plus), E)) = r(S, E) .
  eq builtin(S, ap(s('Plus), I :: J :: A)) = builtin(S, ap(s('Plus), (I + J) :: A)) .
  ceq builtin(S, ap(s('Plus), 0 :: A)) = builtin(S, ap(s('Plus), A)) if lenA(A) >= 1 .
  eq builtin(S, ap(s('Times), nilA)) = r(S, 1) .
  eq builtin(S, ap(s('Times), E)) = r(S, E) .
  eq builtin(S, ap(s('Times), I :: J :: A)) = builtin(S, ap(s('Times), (I * J) :: A)) .
  ceq builtin(S, ap(s('Times), 1 :: A)) = builtin(S, ap(s('Times), A)) if lenA(A) >= 1 .
  ceq builtin(S, ap(s('Times), 0 :: A)) = r(S, 0) if lenA(A) >= 1 .

  ceq builtin(S, ap(s('Power), I :: J)) = r(S, I ^ J) if J >= 0 .
  eq builtin(S, ap(s('Less), I :: J)) = r(S, bool2wl(I < J)) .
  eq builtin(S, ap(s('Greater), I :: J)) = r(S, bool2wl(I > J)) .
  eq builtin(S, ap(s('LessEqual), I :: J)) = r(S, bool2wl(I <= J)) .
  eq builtin(S, ap(s('GreaterEqual), I :: J)) = r(S, bool2wl(I >= J)) .
  eq builtin(S, ap(s('Equal), I :: J)) = r(S, bool2wl(I == J)) .
  ceq builtin(S, ap(s('Equal), E :: E1)) = r(S, s('True)) if E == E1 .

  eq builtin(S, ap(s('Head), ap(H, A))) = r(S, H) .
  eq builtin(S, ap(s('Head), I)) = r(S, s('Integer)) .
  eq builtin(S, ap(s('Head), str(Str))) = r(S, s('String)) .
  eq builtin(S, ap(s('Head), s(Q))) = r(S, s('Symbol)) .
  eq builtin(S, ap(s('Length), ap(H, A))) = r(S, lenA(A)) .
  eq builtin(S, ap(s('Length), I)) = r(S, 0) .
  eq builtin(S, ap(s('Length), str(Str))) = r(S, 0) .
  eq builtin(S, ap(s('Length), s(Q))) = r(S, 0) .

  eq builtin(S, ap(s('Evaluate), E)) = r(S, E) .

  *** attribute builtins
  eq builtin(st(Ds, At, N), ap(s('Attributes), s(F)))
    = r(st(Ds, At, N), ap(s('List), attrsOf(At, F))) .
  eq builtin(st(Ds, At, N), ap(s('SetAttributes), s(F) :: s(AT)))
    = r(st(Ds, at(F, AT) && delAt(At, F, AT), N), s('Null)) .
  eq builtin(st(Ds, At, N), ap(s('SetAttributes), s(F) :: ap(s('List), A)))
    = r(st(Ds, addAts(At, F, A), N), s('Null)) .
  op addAts : Attrs Qid ArgList -> Attrs .
  eq addAts(At, F, nilA) = At .
  eq addAts(At, F, s(AT) :: A) = addAts(at(F, AT) && delAt(At, F, AT), F, A) .
  eq builtin(st(Ds, At, N), ap(s('ClearAttributes), s(F) :: s(AT)))
    = r(st(Ds, delAt(At, F, AT), N), s('Null)) .

  *** ReplaceAll: expr /. rule(s); outermost, once per subtree; the
  *** replaced result is re-evaluated (guarded: only when changed)
  op compileRules : ArgList -> Defs .
  eq compileRules(ap(s('Rule), L :: Rh)) = d(compileP(L), Rh) | noD .
  eq compileRules(ap(s('List), A)) = compileRulesL(A) .
  op compileRulesL : ArgList -> Defs .
  eq compileRulesL(nilA) = noD .
  eq compileRulesL(ap(s('Rule), L :: Rh) :: A)
    = d(compileP(L), Rh) | compileRulesL(A) .

  op rAll : ArgList Defs -> ArgList .
  op rTry : Expr Defs Defs -> Expr .
  eq rAll(nilA, Ds) = nilA .
  eq rAll(E :: A, Ds) = rTry(E, Ds, Ds) :: rAll(A, Ds) .
  ceq rTry(E, d(P, Rh) | Ds, Ds0) = sbE(Rh, s2b(Sb))
    if Sb := metaMatch(MOD, P, subj(E), nil, 0) .
  eq rTry(E, Dd | Ds, Ds0) = rTry(E, Ds, Ds0) [owise] .
  eq rTry(ap(H, A), noD, Ds0) = ap(rTry(H, Ds0, Ds0), rAll(A, Ds0)) .
  eq rTry(E, noD, Ds0) = E [owise] .

  ceq builtin(S, ap(s('ReplaceAll), E :: E1))
    = if V == E then r(S, E) else ev(S, V) fi
    if V := rTry(E, compileRules(E1), compileRules(E1)) .

  *** anything else is inert
  eq builtin(S, E) = r(S, E) [owise] .

  *** ---------------------------------------------------- driver
  op initialFuel : -> Nat .
  eq initialFuel = 1000000 .
  op initialState : -> St .
  eq initialState = st(noD, defaultAttrs, initialFuel) .

  op run : ArgList -> Expr .
  ceq run(A) = V if r(S, V) := evSeq(initialState, A, s('Null)) .

  op runAll : ArgList -> ArgList .
  eq runAll(A) = runAll2(initialState, A) .
  op runAll2 : St ArgList -> ArgList .
  eq runAll2(S, nilA) = nilA .
  ceq runAll2(S0, E :: A) = V :: runAll2(S1, A)
    if r(S1, V) := ev(S0, E) .
endfm
